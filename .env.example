# --- Trying the app locally first? -----------------------------------------
# Set this to true to skip Microsoft sign-in and SharePoint entirely.
# The app runs with fake in-memory data — nothing is saved anywhere, and
# everything below can stay blank while this is true. Flip it back to
# false (or delete the line) once your Entra ID app + SharePoint site
# are ready, per the Build Guide.
VITE_WORKHUB_MOCK_MODE=true

# --- Read by the Electron MAIN process (electron/main.js) ------------------
# Entra ID app registration (see Build Guide, Step 2)
WORKHUB_TENANT_ID=your-tenant-id-guid
WORKHUB_CLIENT_ID=your-app-client-id-guid

# --- Read by the Vite RENDERER (must be prefixed VITE_ to be exposed) ------
# SharePoint site that stores Workora data (see Build Guide, Step 1)
VITE_WORKHUB_SITE_HOSTNAME=phasorgrid.sharepoint.com
VITE_WORKHUB_SITE_PATH=/sites/WorkHub

{
  "name": "phasorgrid-timely",
  "version": "1.0.0",
  "description": "PhasorGrid Timely — time tracking, timesheets, billing and analytics backed by Microsoft Graph (SharePoint + OneDrive)",
  "main": "electron/main.js",
  "author": "PhasorGrid Engineering Ltd.",
  "license": "UNLICENSED",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "release:win": "npm run build:renderer && electron-builder --win --publish always",
    "release:mac": "npm run build:renderer && electron-builder --mac --publish always",
    "release:linux": "npm run build:renderer && electron-builder --linux --publish always",
    "provision": "node scripts/provision-sharepoint-graph.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "^2.13.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.1"
  },
  "build": {
    "appId": "com.phasorgrid.timely",
    "productName": "PhasorGrid Timely",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "icon": "electron/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "phasorgridgit",
      "repo": "PharoGrid-Timely"
    }
  }
}
